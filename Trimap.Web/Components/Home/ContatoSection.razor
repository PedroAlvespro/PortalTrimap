<section class="contato-section section-anchor" id="contato" aria-labelledby="contato-title">
    <div class="contato-section__info">
        <div class="section-heading">
            <span>Contato</span>
            <h2 id="contato-title">Fale com nossa equipe.</h2>
        </div>
        <address>
            <strong>Endereço</strong>
            Rua Exemplo, 123 - Centro, São Paulo - SP<br />
            <strong>Telefone</strong>
            <a href="tel:+551100000000">(11) 0000-0000</a><br />
            <strong>E-mail</strong>
            <a href="mailto:contato@trimap.com.br">contato@trimap.com.br</a>
        </address>
    </div>

    <form class="contato-section__form" aria-label="Formulário visual de contato">
        <label>
            Nome
            <input type="text" name="nome" placeholder="Seu nome" />
        </label>
        <label>
            E-mail
            <input type="email" name="email" placeholder="seu@email.com" />
        </label>
        <label>
            Mensagem
            <textarea name="mensagem" rows="5" placeholder="Como podemos ajudar?"></textarea>
        </label>
        <button type="button">Enviar mensagem</button>
    </form>
</section>
